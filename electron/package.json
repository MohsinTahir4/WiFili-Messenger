{
  "name": "wifili-messenger",
  "version": "1.0.0",
  "description": "100% Offline P2P LAN Chat & Calling App - Cross-Platform Electron Desktop & Web Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": ["lan", "chat", "p2p", "offline", "electron", "windows", "linux"],
  "author": "Mohsin Tahir",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.example.lanchat.electron",
    "productName": "WiFili Messenger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "../web/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
