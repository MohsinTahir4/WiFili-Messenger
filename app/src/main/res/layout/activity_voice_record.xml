<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_voice_record"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/voice_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_cancel_voice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Voice Message"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recording Circle with Pulsing Mic -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:gravity="center">

            <!-- Outer Pulse Ring -->
            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#1E293B" />

            <!-- Middle Ring -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#0F294A" />

            <!-- Central Mic Button -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#1E65F3"
                android:padding="20dp"
                android:src="@drawable/ic_mic_red"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Recording..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_record_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textColor="#94A3B8"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Waveform visualizer representation -->
        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View android:layout_width="4dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="24dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="36dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="18dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="30dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="40dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="22dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="34dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="16dp" android:layout_margin="2dp" android:background="#1E65F3" />
            <View android:layout_width="4dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="#1E65F3" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp">

        <ImageButton
            android:id="@+id/btn_discard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#334155"
            android:src="@drawable/ic_close" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_send_voice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#1E65F3"
            android:src="@drawable/ic_check" />
    </LinearLayout>

</RelativeLayout>
