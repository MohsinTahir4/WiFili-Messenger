<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_call"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Remote Video View (Full Screen) -->
    <ImageView
        android:id="@+id/iv_remote_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Dark Overlay for contrast -->
    <View
        android:id="@+id/video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:visibility="gone" />

    <!-- Header / Info Bar -->
    <LinearLayout
        android:id="@+id/layout_call_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="60dp">

        <TextView
            android:id="@+id/tv_call_avatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#6366F1"
            android:gravity="center"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_call_peer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Peer Name"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calling..."
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Local Camera Preview (Floating Picture-in-Picture Card) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_local_preview"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="60dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <TextureView
            android:id="@+id/tv_local_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Incoming Call Action Buttons (Accept / Decline) -->
    <LinearLayout
        android:id="@+id/layout_incoming_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_decline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Decline"
                android:src="@drawable/ic_call_end"
                app:backgroundTint="#EF4444"
                app:fabCustomSize="64dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Decline"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_accept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Accept"
                android:src="@drawable/ic_call"
                app:backgroundTint="#22C55E"
                app:fabCustomSize="64dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Accept"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active In-Call Action Controls -->
    <LinearLayout
        android:id="@+id/layout_active_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_toggle_mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#1E293B"
            android:src="@drawable/ic_mic_red"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_speaker"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#1E293B"
            android:src="@drawable/ic_speaker"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#1E293B"
            android:src="@drawable/ic_switch_camera"
            app:tint="#FFFFFF" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_hangup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:contentDescription="End Call"
            android:src="@drawable/ic_call_end"
            app:backgroundTint="#EF4444"
            app:fabCustomSize="64dp"
            app:tint="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
